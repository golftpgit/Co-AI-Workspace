<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox on from day one (ARCHITECTURE §13): retrofitting it later
	     is far more expensive than living inside it from the start. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Talk to bundled sidecars on 127.0.0.1, to self-hosted inference
	     endpoints (GX10/LM Studio) and to tiered web/API sources. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- LINE bridge runs a local webhook listener (ARCHITECTURE §8.1). -->
	<key>com.apple.security.network.server</key>
	<true/>

	<!-- User-chosen project folders and documents. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
</dict>
</plist>
