"ambiguous — it can be read more than one way" = "กำกวม — ตีความได้หลายแบบ";
"a method has to be chosen" = "ต้องเลือกวิธี";
"the plan cannot be approved yet:\n" = "ยังอนุมัติแผนไม่ได้:\n";
"the plan holds no decisions yet" = "แผนยังไม่มีการตัดสินใจใดๆ";
"still an agent's proposal that nobody has confirmed: %@" = "ยังเป็นข้อเสนอของ agent ที่ยังไม่มีคนยืนยัน: %@";
"changed the decision “%@” after approval" = "แก้การตัดสินใจ “%@” หลังอนุมัติ";
"answered the gap “%@” after approval" = "ตอบช่องว่าง “%@” หลังอนุมัติ";
"added the decision “%@” after approval" = "เพิ่มการตัดสินใจ “%@” หลังอนุมัติ";
"found the new gap “%@” after approval" = "พบช่องว่างใหม่ “%@” หลังอนุมัติ";

/* ── CoreTypes ───────────────────────────────────────────────── */

"the scope is not known" = "ไม่รู้ว่าเป็น scope ไหน";
