/* ── Agreement ───────────────────────────────────────────────── */

"%@ = %.3f (95%% CI %.3f to %.3f, n = %d, p = %.4f)" = "%@ = %.3f (95%% CI %.3f ถึง %.3f, n = %d, p = %.4f)";
" — **correlation is not agreement**: two instruments that read exactly double each other " = " — **ความสัมพันธ์ไม่ใช่ความสอดคล้อง**: เครื่องมือสองชิ้นที่อ่านค่าเป็นสองเท่าของกันและกันเป๊ะ ๆ ";
"score r = 1.00 and never once agree · if the question is 'can one replace the other', use Bland–Altman" = "ได้ r = 1.00 และไม่ตรงกันสักค่าเดียว ถ้าคำถามคือ 'วัดแทนกันได้ไหม' ให้ใช้ Bland–Altman";
"worse than guessing" = "แย่กว่าการเดา";
"almost no agreement" = "เกือบไม่ตรงกันเลย";
"slight agreement" = "ตรงกันน้อย";
"moderate agreement" = "ตรงกันปานกลาง";
"substantial agreement" = "ตรงกันดี";
"almost perfect agreement" = "ตรงกันดีมาก";
"κ%@ = %.3f (95%% CI %.3f to %.3f) — %@" = "κ%@ = %.3f (95%% CI %.3f ถึง %.3f) — %@";
" weighted" = " ถ่วงน้ำหนัก";
" · raw agreement %.1f%%, of which %.1f%% was the agreement chance alone would have produced" = " · ตรงกันดิบ %.1f%% ซึ่ง %.1f%% เป็นการตรงกันที่คาดได้จากความบังเอิญ";
"both sets must have the same number of values" = "ต้องมีจำนวนค่าเท่ากันทั้งสองชุด";
"at least 4 pairs are needed" = "ต้องมีอย่างน้อย 4 คู่";
"one of the sets is a single repeated value — there is no correlation to find" = "ชุดใดชุดหนึ่งมีค่าเดียวกันทั้งหมด — หาความสัมพันธ์ไม่ได้";
"the two raters must have rated the same items" = "ผู้ให้คะแนนสองคนต้องให้คะแนนรายการชุดเดียวกัน";
"at least two items are needed" = "ต้องมีอย่างน้อยสองรายการ";
"there is only one category — agreement has nothing to measure" = "มีหมวดเดียว — ความตรงกันไม่มีอะไรให้วัด";
"chance agreement is 100% — κ is undefined" = "ความตรงกันที่คาดจากความบังเอิญเท่ากับ 100%% — κ ไม่นิยาม";

