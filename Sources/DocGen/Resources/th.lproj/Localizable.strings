/* ── Limitations ─────────────────────────────────────────────── */

"%@\n\nno limitation was recorded by the steps that ran" = "%@\n\nไม่พบข้อจำกัดที่ระบบบันทึกไว้จากขั้นตอนที่ผ่านมา";
"%@ was set to “%@” " = "%@ กำหนดเป็น “%@” ";
