" — confirmed by the researcher" = " — ผู้วิจัยยืนยันแล้ว";
"sources conflicted on “%@” — " = "มีแหล่งที่ขัดกันในประเด็น “%@” — ";
"resolved as: %@ " = "เลือกใช้: %@ ";
"the researcher" = "ผู้วิจัย";
"the system" = "ระบบ";
"(decided by %@ on %@)" = "(ตัดสินโดย%@ เมื่อ %@)";
"Density of evidence" = "ความหนาแน่นของหลักฐาน";
"evidence cited: %@" = "หลักฐานที่อ้างอิง: %@";
"statistical assumption: %@" = "ข้อสมมติทางสถิติ: %@";
"side A — %@" = "ฝั่ง A — %@";
"side B — %@" = "ฝั่ง B — %@";
